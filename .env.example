# -----------------------------------------------------
# OLLAMA CONFIGURATION
# -----------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_CONTEXT_WINDOW=4096
OLLAMA_TEMPERATURE=0.3

# -----------------------------------------------------
# AUDIO PIPELINE
# -----------------------------------------------------
STT_MODEL=faster-whisper-tiny.en
TTS_MODEL=en_US-lessac-medium

# -----------------------------------------------------
# GUARDRAILS & SAFETY
# -----------------------------------------------------
# Set to 'true' to allow destructive OS commands (rm, del, format)
ALLOW_DESTRUCTIVE_COMMANDS=false

# Comma-separated list of directories Peter is forbidden from accessing
RESTRICTED_DIRECTORIES=C:\Windows,C:\Program Files,C:\Program Files (x86)
